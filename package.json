{
  "name": "svgiconcreator",
  "version": "3.2.0",
  "scripts": {
    "start": "ng serve -o",
    "start:public": "ng serve -o --host 0.0.0.0 --port 80",
    "start:prod": "mv dist/svgiconcreator dist/dist && mv dist/dist/browser dist/dist/creador-iconos-svg && cd dist/dist/ && live-server . --open=creador-iconos-svg",
    "build": "ng build --base-href /creador-iconos-svg/",
    "test": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "test:watch": "ng test --browsers=ChromeHeadless",
    "icons": "ng run svgiconcreator:icons",
    "aws-checks": "ng run svgiconcreator:aws-checks",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@jaimemartinmartin15/jei-devkit-angular-shared": "^6.0.1",
    "@jaimemartinmartin15/svg-icons": "^1.7.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.15",
    "@angular/cli": "^21.2.15",
    "@angular/compiler-cli": "^21.2.17",
    "@eslint/js": "^9.35.0",
    "@jaimemartinmartin15/jei-devkit-angular-builders": "^3.4.0",
    "@types/jasmine": "^5.1.12",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "jasmine-core": "^5.12.1",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 170
  }
}
