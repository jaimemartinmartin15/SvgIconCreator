{
  "name": "creador-iconos-svg",
  "version": "1.0.1",
  "scripts": {
    "start": "ng serve -o",
    "start:public": "ng serve -o --host 0.0.0.0 --port 80",
    "start:prod": "mv dist/creador-iconos-svg dist/dist && mv dist/dist/browser dist/dist/creador-iconos-svg && cd dist/dist/ && live-server . --open=creador-iconos-svg",
    "build": "ng build --base-href /creador-iconos-svg/"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.14",
    "@angular/common": "^19.2.14",
    "@angular/compiler": "^19.2.14",
    "@angular/core": "^19.2.14",
    "@angular/forms": "^19.2.14",
    "@angular/platform-browser": "^19.2.14",
    "@angular/platform-browser-dynamic": "^19.2.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.14",
    "typescript": "~5.5.4"
  }
}