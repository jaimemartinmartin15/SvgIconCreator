{
  "name": "svgiconcreator",
  "version": "2.0.0",
  "scripts": {
    "start": "ng serve -o",
    "start:public": "ng serve -o --host 0.0.0.0 --port 80",
    "start:prod": "mv dist/svgiconcreator dist/dist && mv dist/dist/browser dist/dist/creador-iconos-svg && cd dist/dist/ && live-server . --open=creador-iconos-svg",
    "build": "ng build --base-href /creador-iconos-svg/",
    "test": "ng test --no-watch --no-progress --browsers=ChromeHeadless",
    "test:watch": "ng test --browsers=ChromeHeadless",
    "icons": "ng run svgiconcreator:icons",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^20.2.12",
    "@angular/common": "^20.3.9",
    "@angular/compiler": "^20.3.10",
    "@angular/core": "^20.3.9",
    "@angular/forms": "^20.3.9",
    "@angular/platform-browser": "^20.3.9",
    "@angular/router": "^20.3.9",
    "@jaimemartinmartin15/jei-devkit-angular-shared": "^5.0.1",
    "@jaimemartinmartin15/svg-icons": "^1.3.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.3.9",
    "@angular/build": "^20.3.9",
    "@angular/cli": "^20.3.9",
    "@angular/compiler-cli": "^20.3.9",
    "@eslint/js": "^9.35.0",
    "@jaimemartinmartin15/jei-devkit-angular-builders": "^3.1.2",
    "@types/jasmine": "^5.1.12",
    "eslint": "^9.35.0",
    "globals": "^16.4.0",
    "jasmine-core": "^5.12.1",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.43.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 170
  }
}
